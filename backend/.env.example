# ============================================================
# Configurações do Django (EduSchedule AI / Timetabling)
# ============================================================

# Chave secreta da aplicação (gere uma chave segura para produção)
DJANGO_SECRET_KEY=django-insecure-eduschedule-timetabling-secret-key-2026

# Modo de depuração (True em desenvolvimento, False em produção)
DJANGO_DEBUG=True

# Hosts autorizados (separados por vírgula)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ============================================================
# Banco de Dados
# ============================================================
# Opções de DB_ENGINE:
# - postgresql (Recomendado / Produção / Docker)
# - sqlite     (Desenvolvimento rápido local sem Docker)
# - mysql      (Legado / Opcional)
DB_ENGINE=sqlite

# Configurações para PostgreSQL / MySQL (ignoradas se DB_ENGINE=sqlite)
DB_NAME=timetabling
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
